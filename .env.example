# ========================================================
# EdTech CRM & Inquiry System - Environment Variables Template
# ========================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase PostgreSQL Database Connection
# You can find this in your Supabase Dashboard:
# Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Custom JWT Authentication Configuration (Supabase Auth is NOT used)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Default Admin Credentials (Auto-seeded when initializing database)
ADMIN_DEFAULT_NAME="Lead Administrator"
ADMIN_DEFAULT_EMAIL=admin@edutech.com
ADMIN_DEFAULT_PASSWORD=Admin@123

# Frontend API Endpoint (Used by Vite)
VITE_API_URL=http://localhost:5000/api
