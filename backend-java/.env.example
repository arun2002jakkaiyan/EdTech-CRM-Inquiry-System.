# ========================================================
# Java Spring Boot Backend Environment Variables Template
# ========================================================

# Server Port
PORT=5000

# Supabase PostgreSQL Database JDBC URL
# In Supabase: Project Settings -> Database -> Connection String
# Example format for PostgreSQL JDBC driver:
# DATABASE_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&user=postgres.your-project-ref&password=your-password
DATABASE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=your_supabase_db_password

# Custom JWT Authentication Secrets (Supabase Auth is NOT used)
JWT_SECRET=edtech_crm_super_secure_jwt_secret_key_2026_xyz_at_least_32_bytes
JWT_EXPIRATION_MS=604800000

# Default Admin Credentials (Auto-seeded into database on start)
ADMIN_DEFAULT_NAME=Lead Administrator
ADMIN_DEFAULT_EMAIL=admin@edutech.com
ADMIN_DEFAULT_PASSWORD=Admin@123
